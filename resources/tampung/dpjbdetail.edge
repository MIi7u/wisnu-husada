<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Pasien DPJP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <!-- Link untuk Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Link untuk Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>

    <style>
        table.dataTable, table.dataTable th, table.dataTable td {
            border: 1px solid #dee2e6 !important;
        }
        table.dataTable {
            border-collapse: collapse !important;
        }
        table.dataTable thead th, table.dataTable tfoot th {
            background-color: rgb(4, 87, 49) !important;
            color: white !important;
            text-align: center;
        }
        table.dataTable tbody tr:hover {
            background-color: #f1f1f1;
        }
        table.dataTable tfoot tr:first-child td {
            height: 20px;
            border: none !important;
            background-color: transparent !important;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .card-header {
            background-color: rgb(4, 87, 49);
            color: white;
        }
        .card-body {
            padding: 1.5rem;
        }
        /* Custom style for the Select2 */
        .select2-container {
            width: 100% !important;
        }
    </style>
</head>
<body>

<div class="container mt-4">
    <div class="card">
        <h5 class="p-3">Detail Data Pasien DPJP {{nip_dokter}}</h5>
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span></span>
            <div class="d-flex gap-2 flex-wrap">
               <a href="/" class="btn btn-primary">Kembali</a>
                <button id="exportExcel" class="btn btn-light btn-sm">📥 Export Excel</button>
                <button id="exportWord" class="btn btn-light btn-sm">📄 Export Word</button>
                <button id="exportPDF" class="btn btn-light btn-sm">🖶 Export PDF</button>
            </div>
        </div>

        <div class="card-body">
            <!-- Card untuk Filter -->
            <div class="card mb-3 p-3">
                <form id="cekbox" method="POST" action="/admin/lenkapdpjbdetail">
                    {{ csrfField() }}
                    <div class="row g-3">
                        <!-- Input Tanggal Awal -->
                        <div class="col-12 col-md-4">
                            <label class="fw-bold">Tanggal Awal</label>
                            <input type="date" id="startDate" name="startDate" class="form-control" value="{{tanggal_awal }}">
                        </div>
                        <!-- Input Tanggal Akhir -->
                        <div class="col-12 col-md-4">
                            <label class="fw-bold">Tanggal Akhir</label>
                            <input type="date" id="endDate" name="endDate" class="form-control" value="{{tanggal_akhir }}">
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="fw-bold">Pilih Dokter</label>
                            <select class="form-select" id="nipDokter" name="nip_dokter">
                                <option value="">Pilih Dokter</option>
                                @each(data in dpjbdetail)
                                    <option value="{{ data.nip_dokter }}" data-name="{{ data.nm_dokter }}">
                                        {{ data.nip_dokter }} - {{ data.nm_dokter }} ({{ data.nm_spesialis }})
                                    </option>
                                @endeach
                            </select>                  
                         </div>
                    </div>

                    <!-- Jenis Pasien (Horizontal) dan Pilih Dokter di sebelah kanan -->
                    <div class="row mt-3">
                        <div class="col-12 col-md-8">
                            <label class="fw-bold">Jenis Pasien</label>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input filter-jenis-pasien" type="checkbox" name="jenis_pasien[]" id="rawatJalan" value="jalan">
                                <label class="form-check-label" for="rawatJalan">👨‍⚕️ Rawat Jalan</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input filter-jenis-pasien" type="checkbox" name="jenis_pasien[]" id="rawatInap" value="inap">
                                <label class="form-check-label" for="rawatInap">👨‍⚕️ Rawat Inap</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input filter-jenis-pasien" type="checkbox" name="jenis_pasien[]" id="igd" value="IGD">
                                <label class="form-check-label" for="igd">🚑 IGD</label>
                            </div>
                        </div>
                    </div>

                    <!-- Tombol Filter -->
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success w-100 w-md-auto">🔍 Filter Data</button>
                    </div>
                    
                </form>
            </div>

           

            <!-- DataTables -->
            <div class="table-responsive">
                <table id="patientTable" class="table table-striped">
                    <thead>
                        <tr>
                            <th>NO</th>
                            <th>Nama Pasien</th>
                            <th>No RM</th>
                            <th>Qty Visit</th>
                            <th>Tagihan Visit Rp.</th>
                            <th>Qty Konsul</th>
                            <th>Tagihan Konsul Rp.</th>
                            <th>Tagihan Tindakan Rp.</th>
                            <th>Tagihan Sewa Alat Rp.</th>
                            <th>Total Jumlah Diterima Rp.</th>
                            <th>Qty Asal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @each(data in lenkapdpjbdetail )
                            <tr>
                                <td>{{index=+1 }}</td>
                                <td>{{ data.nm_pasien}}</td>
                                <td>{{ data.no_rm}}</td>
                                <td>{{ data.qty_visit }}</td>
                                <td>{{ data.tagihan_visit }}</td>
                                <td>{{ data.qty_konsul }}</td>
                                <td>{{ data.tagihan_konsul }}</td>
                                <td>{{ data.tagihan_tindakan }}</td>
                                <td>{{ data.tagihan_sewa_alat }}</td>
                                <td class="jumlah">{{ data.total_jumlah_diterima }}</td>
                                <td>{{ data.qty_asal }}</td>
                            </tr>
                        @endeach
                    </tbody>
                    <tfoot>
                        <tr><td colspan="8" style="height:20px; border: none;"></td></tr>
                        <tr><td colspan="3">Total Rawat Jalan</td><td colspan="2" id="totalRawatJalan"></td></tr>
                        <tr><td colspan="3">Total Rawat Inap</td><td colspan="2" id="totalRawatInap"></td></tr>
                        <tr><td colspan="3">Total Sewa Alat</td><td colspan="2" id="totalSewaAlat"></td></tr>
                        <tr><td colspan="3">Total Semua</td><td colspan="2" id="totalSemua"></td></tr>
                        <tr><td colspan="3">PPn 21</td><td colspan="2" id="ppn21"></td></tr>
                        <tr><td colspan="3" class="fw-bold text-primary">Yang Diterima</td><td colspan="2" class="fw-bold text-primary" id="yangDiterima"></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
       
        // Setup Select2 untuk dropdown pencarian dokter
        $('#nipDokter').select2({
            placeholder: "Pilih Dokter",
            allowClear: true
        });

        // Setup DataTable
        var table = $('#patientTable').DataTable();

        // Fungsi perhitungan total
        function calculateTotals() {
            let totalRawatJalan = 0;
            let totalRawatInap = 0;
            let totalSewaAlat = 0;
            let totalSemua = 0;
            let ppn21 = 0;

            // Iterasi setiap baris di DataTable
            table.rows().every(function () {
                var data = this.data();
                // Hitung total berdasarkan jenis pasien dan jumlah diterima
                if (data[5] == '1') totalRawatJalan += parseFloat(data[9]) || 0;
                if (data[5] == '2') totalRawatInap += parseFloat(data[9]) || 0;
                totalSewaAlat += parseFloat(data[8]) || 0;
            });

            // Hitung total semua
            totalSemua = totalRawatJalan + totalRawatInap + totalSewaAlat;

            // Hitung PPn 21% dari Total Semua
            ppn21 = totalSemua * 0.21;

            // Update footer
            $('#totalRawatJalan').text(totalRawatJalan.toLocaleString('id-ID'));
            $('#totalRawatInap').text(totalRawatInap.toLocaleString('id-ID'));
            $('#totalSewaAlat').text(totalSewaAlat.toLocaleString('id-ID'));
            $('#totalSemua').text(totalSemua.toLocaleString('id-ID'));
            $('#ppn21').text(ppn21.toLocaleString('id-ID'));

            let totalDiterima = totalSemua + ppn21;
            $('#yangDiterima').text(totalDiterima.toLocaleString('id-ID'));
        }

        // Panggil fungsi perhitungan
        calculateTotals();
    });
</script>

</body>
</html>
