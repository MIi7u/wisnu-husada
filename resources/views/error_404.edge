<body>

  <main>
    <div class="container">

      <section class="section error-404 min-vh-100 d-flex flex-column align-items-center justify-content-center">
      <center>
      <br>
      <br>
        <div style="font-size:30px;font-weight:10px"><strong>Maaf Halaman Bermasalah</strong></div>
