<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>WISNU</title>
  
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

  <style>
    body {
      background: url('/images/bg1.png') no-repeat center center fixed;
      background-size: cover;
    }
    .navbar-custom {
      background: linear-gradient(to bottom, #8bc34a, #357905);
    }
    .navbar-custom .navbar-brand,
    .navbar-custom .nav-link,
    .navbar-custom .navbar-toggler-icon {
      color: #fff !important;
    }
    .dropdown-menu {
      background-color: #357905;
      border-radius: 8px;
      padding: 5px 0;
    }
    .dropdown-item {
      color: #fff !important;
    }
    .dropdown-item:hover {
      background-color: #128e2fff;
    }
    .content-wrapper {
      background: rgba(255,255,255,0.9);
      padding: 20px;
      border-radius: 10px;
      margin-top: 20px;
    }

    /* === Submenu agar popup otomatis saat hover === */
    .dropdown-submenu {
      position: relative;
    }
    .dropdown-submenu > .dropdown-menu {
      top: 0;
      left: 100%;
      margin-left: 0.1rem;
      display: none;
    }
    .dropdown-submenu:hover > .dropdown-menu {
      display: block;
    }

    /* Animasi muncul */
    .dropdown-menu, .dropdown-submenu > .dropdown-menu {
      transition: all 0.2s ease-in-out;
    }
  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">WISNU</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
            data-bs-target="#navbarNav" aria-controls="navbarNav" 
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">

        <!-- Dropdown Transaksi -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="transaksiMenu" 
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Transaksi
          </a>
          <ul class="dropdown-menu" aria-labelledby="transaksiMenu">
            <li><a class="dropdown-item" href="/admin/pending">Pendaftaran </a></li>
          </ul>
        </li>
        <!-- Dropdown Master -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="masterMenu" 
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Master
          </a>
          <ul class="dropdown-menu" aria-labelledby="masterMenu">
            <!-- Submenu Pasien -->
            <li>
              <a class="dropdown-item" href="/admin/pasien">Pasien</a>
            </li>
            <li><a class="dropdown-item" href="/admin/dokter">Dokter</a></li>
             <li><a class="dropdown-item" href="/admin/perawat">Perawat</a></li>
             <li><a class="dropdown-item" href="/admin/spesialis/">Spesialis</a></li>
             <li><a class="dropdown-item" href="/admin/tindakan/">Tindakan</a></li>
             <li><a class="dropdown-item" href="/admin/basecode/">Basecode</a></li>
             <li><a class="dropdown-item" href="/admin/modifiers/">Modifiers</a></li>
          </ul>
        </li>

        <!-- Dropdown Laporan -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="laporanMenu" 
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Laporan
          </a>
          <ul class="dropdown-menu" aria-labelledby="laporanMenu">
            <li><a class="dropdown-item" href="/admin/pending">Pending BPJS</a></li>
            <li><a class="dropdown-item" href="/admin/rincian">Rincian Jasa Medis BPJS</a></li>
            <li><a class="dropdown-item" href="/admin/nonbpjs">Rincian Jasa Medis NON BPJS</a></li>
          </ul>
        </li>
      </ul>
      <img src="/images/logo_rsi.png" alt="Logo" height="40">
    </div>
  </div>
</nav>

<!-- CONTENT DINAMIS -->

<div class="container-fluid mt-3">
    <div id="main-content">
        <div class="content-wrapper text-center">
            <h3>Selamat Datang di WISNU</h3>
            <p>
                Silakan pilih menu di atas
            </p>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
