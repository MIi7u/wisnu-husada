<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail DPJP - {{ dpjp }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <style>
        table.dataTable, table.dataTable th, table.dataTable td {
            border: 1px solid #dee2e6 !important;
        }
        table.dataTable {
            border-collapse: collapse !important;
        }
        table.dataTable thead th, table.dataTable tfoot th {
            background-color:rgb(4, 87, 49) !important;
            color: white !important;
            text-align: center;
        }
        table.dataTable tbody tr:hover {
            background-color: #f1f1f1;
        }
        table.dataTable tfoot tr:first-child td {
            height: 20px;
            border: none !important;
            background-color: transparent !important;
        }
    </style>
</head>
<body>

<div class="container mt-4" id="reportContent">
    <div class="card">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span>Detail Data Pasien untuk DPJP: {{ dpjp }}</span>
            <div>
                <button id="exportExcel" class="btn btn-light btn-sm">📥 Export Excel</button>
                <button id="exportWord" class="btn btn-light btn-sm">📄 Export Word</button>
                <button id="exportPDF" class="btn btn-light btn-sm">🧾 Export PDF</button>
            </div>
        </div>
        <div class="card-body">
            <table id="patientTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>KD Registrasi</th>
                        <th>Tanggal Registrasi</th>
                        <th>Status Periksa</th>
                        <th>Keterangan</th>
                        <th>Tarif Inacbg</th>
                        <th>Total Tagihan</th>
                        <th>Nama Pasien</th>
                    </tr>
                </thead>
                <tbody>
                    @each(data in dpjbdetail)
                        <tr>
                            <td></td>
                            <td>{{ data.kd_registrasi }}</td>
                            <td>{{ data.tgl_registrasi }}</td>
                            <td>{{ data.nm_status_periksa }}</td>
                            <td>{{ data.keterangan }}</td>
                            <td class="tarif_inacbg">{{ data.tarif_inacbg }}</td>
                            <td class="total_tagihan">{{ data.total_tagihan }}</td>
                            <td>{{ data.nm_pasien }}</td>
                        </tr>
                    @endeach
                </tbody>
                <tfoot>
                    <tr><td colspan="8" style="height:20px; border: none;"></td></tr>
                    <tr><td colspan="3">Total Rawat Jalan</td><td colspan="2" id="totalRawatJalan"></td></tr>
                    <tr><td colspan="3">Total Rawat Inap</td><td colspan="2" id="totalRawatInap"></td></tr>
                    <tr><td colspan="3">Total Sewa Alat</td><td colspan="2" id="totalSewaAlat"></td></tr>
                    <tr><td colspan="3">Total Semua</td><td colspan="2" id="totalSemua"></td></tr>
                    <tr><td colspan="3">PPn 21</td><td colspan="2" id="ppn21"></td></tr>
                    <tr><td colspan="3" class="fw-bold text-primary">Yang Diterima</td><td colspan="2" class="fw-bold text-primary" id="yangDiterima"></td></tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- JS Library -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<!-- Export Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<script>
    $(document).ready(function () {
        let table = $("#patientTable").DataTable({
            paging: true,
            searching: true,
            columnDefs: [
                { orderable: false, targets: 0 },
                { width: "150px", targets: 2 }
            ],
            order: [[1, 'asc']],
            drawCallback: function (settings) {
                let api = this.api();

                // Nomor urut otomatis
                api.rows({ search: 'applied' }).every(function (rowIdx) {
                    api.cell(rowIdx, 0).data(rowIdx + 1);
                });

                // Format tanggal
                api.column(2, { search: 'applied' }).nodes().each(function (cell) {
                    let originalDate = $(cell).text().trim();
                    if (originalDate) {
                        let formattedDate = moment(originalDate, ["YYYY-MM-DD", "DD/MM/YYYY", "MM-DD-YYYY"]).format("DD-MM-YYYY");
                        $(cell).text(formattedDate);
                    }
                });

                // Format angka jadi Rp.
                [5, 6].forEach(function (colIdx) {
                    api.column(colIdx, { search: 'applied' }).nodes().each(function (cell) {
                        let value = parseFloat($(cell).text().replace(/[^0-9.-]+/g, "")) || 0;
                        $(cell).text("Rp. " + value.toLocaleString("id-ID"));
                    });
                });

                // Hitung total tagihan sesuai filter
                let totalSemua = 0;
                api.column(6, { search: 'applied' }).nodes().each(function (cell) {
                    let value = parseFloat($(cell).text().replace(/[^0-9.-]+/g, "")) || 0;
                    totalSemua += value;
                });

                let totalRawatJalan = totalSemua * 0.4;
                let totalRawatInap = totalSemua * 0.4;
                let totalSewaAlat = totalSemua * 0.2;
                let ppn21 = totalSemua * 0.1;
                let yangDiterima = totalSemua - ppn21;

                $("#totalRawatJalan").text("Rp. " + totalRawatJalan.toLocaleString("id-ID"));
                $("#totalRawatInap").text("Rp. " + totalRawatInap.toLocaleString("id-ID"));
                $("#totalSewaAlat").text("Rp. " + totalSewaAlat.toLocaleString("id-ID"));
                $("#totalSemua").text("Rp. " + totalSemua.toLocaleString("id-ID"));
                $("#ppn21").text("Rp. " + ppn21.toLocaleString("id-ID"));
                $("#yangDiterima").text("Rp. " + yangDiterima.toLocaleString("id-ID"));
            }
        });

        // Export Excel
        $("#exportExcel").click(function () {
            let wb = XLSX.utils.table_to_book(document.getElementById("patientTable"), { sheet: "Data DPJP" });
            XLSX.writeFile(wb, "Data_DPJP.xlsx");
        });

        // Export Word
        $("#exportWord").click(function () {
            let table = document.getElementById("patientTable");
            let html = "<html><head><meta charset='UTF-8'>";
            html += "<style>table, th, td { border: 1px solid black; border-collapse: collapse; padding: 5px; } th { background-color: rgb(4,87,49); color: white; }</style>";
            html += "</head><body>";
            html += "<h2>Detail Data DPJP: {{ dpjp }}</h2>";
            html += table.outerHTML;
            html += "</body></html>";

            let blob = new Blob(["\ufeff", html], { type: "application/msword" });
            saveAs(blob, "Data_DPJP.doc");
        });

        // Export PDF
        $("#exportPDF").click(function () {
            html2canvas(document.querySelector("#reportContent")).then(canvas => {
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('l', 'mm', 'a4'); // landscape
                let imgData = canvas.toDataURL("image/png");
                let imgProps = pdf.getImageProperties(imgData);
                let pdfWidth = pdf.internal.pageSize.getWidth();
                let pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                pdf.addImage(imgData, 'PNG', 0, 10, pdfWidth, pdfHeight);
                pdf.save("Data_DPJP.pdf");
            });
        });
    });
</script>

</body>
</html>
