<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>SIMRS-Wisnuhusada</title>
  
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/cariPegawai.js"></script>
</head>
<body>
<header class="d-flex justify-content-between align-items-center p-2 text-white" style="background-color: #2d6e5c;">
    <!-- Kiri -->
    <h5 class="mb-0">SIMRS Klinik Utama Wishnu Husada</h5>
    <!-- Kanan -->
    <div class="d-flex align-items-center gap-2">
        <select id="cariPegawai"><option selected>- Pilih -</option></select>
        <!-- User -->
       <div id="pegawaiTerpilih" class="ms-3 text-white fw-bold">
    </div>
    <img src="/images/logo_wisnu.png" alt="Logo" height="50">
</header>

<nav class="navbar navbar-dark navbar-custom p-0 d-flex flex-column">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Dasboard</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
            data-bs-target="#navbarNav" aria-controls="navbarNav" 
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">

        <!-- Dropdown Rajal -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="rajalMenu" 
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Rawat Jalan
          </a>
          <ul class="dropdown-menu" aria-labelledby="rajalMenuMenu">
            <li><a class="dropdown-item" href="/admin/">Poliklinik</a></li>
            <li><a class="dropdown-item" href="/admin/">Template Persetujuan Tindakan</a></li>
            <li><a class="dropdown-item" href="/admin/">Obat BHP diruang (Rajal) </a></li>
            <li><a class="dropdown-item" href="/admin/">Laporan Kunjungan IGD</a></li>
            <li><a class="dropdown-item" href="/admin/">SEP</a></li>
            <li><a class="dropdown-item" href="/admin/">Obat BHP diruang (IGD)</a></li>
            <li><a class="dropdown-item" href="/admin/">Rawat IGD</a></li>
            <li><a class="dropdown-item" href="/admin/">Laporan Rawat Jalan</a></li>
            <li><a class="dropdown-item" href="/admin/">Tarif di Ruangan</a></li>
            <li><a class="dropdown-item" href="/admin/">Histori Pasien</a></li>
          </ul>
        </li>
<!-- Dropdown RME-->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="pasien_ranapMenu" 
             role="button"  aria-expanded="false">
             <i class="fas fa-bed me-2"></i>
             Lihat RME
          </a>
        </li>
<!-- Dropdown Info Pasien -->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="pasien_ranapMenu" 
             role="button"  aria-expanded="false">
             <i class="fas fa-bed me-2"></i>
             Pasien Ranap
          </a>
        </li>
        <!-- Dropdown Payor -->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="pasien_ranapMenu" 
             role="button"  aria-expanded="false">
             <i class="fas fa-bed me-2"></i>
             Payor
          </a>
        </li>

        <!-- Dropdown Info Pasien -->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="info_pasienMenu" 
             role="button" aria-expanded="false"><i class="fas fa-user-injured me-2"></i>
             Info Pasien 
          </a>
        </li>

        <!-- Dropdown Pasien Dr Umum -->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="info_pasienMenu" 
             role="button" aria-expanded="false"><i class="fas fa-user-injured me-2"></i>
             Pasien Dokter Umum
          </a>
        </li>

         <!-- Dropdown Info Pasien -->
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" id="info_pasienMenu" 
             role="button" aria-expanded="false"><i class="fas fa-user-injured me-2"></i>
             Info Tagihan Pasien 
          </a>
        </li>
        <!-- Dropdown Transaksi -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="pendaftaranMenu" 
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Pendaftaran
          </a>
          <ul class="dropdown-menu" aria-labelledby="pendaftaranMenu">
            <li><a class="dropdown-item" href="/admin/">Pendaftaran Penunjang </a></li>
            <li><a class="dropdown-item" href="/admin/">SEP</a></li>
            <li><a class="dropdown-item" href="/admin/">Pendaftaran Rawat Jalan</a></li>
            <li><a class="dropdown-item" href="/admin/">Anjungan Pendaftaran</a></li>
           <li><a class="dropdown-item" href="/admin/">Pendaftaran IGD</a></li> 
            <li><a class="dropdown-item" href="/admin/">Pendaftaran Bayi Lahir </a></li>
             <li><a class="dropdown-item" href="/admin/">Pemantauan Task ID</a></li>
                <li><a class="dropdown-item" href="/admin/">SYN</a></li>
            <li><a class="dropdown-item" href="/admin/">Pendaftaran TPPRI</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<!-- CONTENT DINAMIS -->

<div class="container-fluid mt-3">
    <div id="main-content">
       
    </div>
</div>

<script src="/js/app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
</body>
</html>
