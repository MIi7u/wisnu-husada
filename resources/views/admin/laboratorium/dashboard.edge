<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <meta name="csrf-token" content="{{ csrfToken }}">
  <title>SIMRS-Wisnuhusada | Dashboard Laboratorium</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

@include("admin/laboratorium/_navbar")

<div class="container-fluid py-4">

  {{-- ============ Peringatan Dini Stok (Fitur ARIMA) ============ --}}
  @if(peringatanStok.length)
    <div class="alert alert-warning shadow-sm border-start border-warning border-4">
      <h6 class="mb-2"><i class="fas fa-triangle-exclamation me-2"></i>Peringatan Dini Stok Reagen</h6>
      <ul class="mb-1">
        @each(r in peringatanStok)
          <li><strong>{{ r.nama_reagen }}</strong> — stok saat ini <span class="badge bg-danger">{{ r.stok }} {{ r.satuan }}</span> (batas minimal {{ r.safety_stock }}). Segera lakukan pengadaan!</li>
        @endeach
      </ul>
      <a href="/admin/laboratorium/stok" class="btn btn-sm btn-outline-dark mt-1"><i class="fas fa-chart-line me-1"></i>Lihat Prediksi Kebutuhan</a>
    </div>
  @else
    <div class="alert alert-success shadow-sm"><i class="fas fa-circle-check me-2"></i>Tidak ada peringatan dini stok. Semua reagen di atas batas minimal.</div>
  @endif

  {{-- ============ Statistik Harian ============ --}}
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card shadow-sm border-start-primary">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small">Permintaan Hari Ini</div>
            <div class="fs-2 fw-bold text-primary">{{ stats.hariIni }}</div>
          </div>
          <i class="fas fa-clipboard-list fa-3x text-primary opacity-25"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small">Selesai</div>
            <div class="fs-2 fw-bold text-success">{{ stats.selesai }}</div>
          </div>
          <i class="fas fa-circle-check fa-3x text-success opacity-25"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small">Tertunda / Dalam Proses</div>
            <div class="fs-2 fw-bold text-warning">{{ stats.tertunda }}</div>
          </div>
          <i class="fas fa-hourglass-half fa-3x text-warning opacity-25"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    {{-- ============ Notifikasi Hasil Kritis ============ --}}
    <div class="col-md-7">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white">
          <h6 class="mb-0 text-danger"><i class="fas fa-biohazard me-2"></i>Notifikasi Kritis (Panic Value) — Butuh Validasi Segera</h6>
        </div>
        <div class="card-body p-0">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
              <tr><th>No. Permintaan</th><th>Pasien</th><th>Parameter</th><th>Hasil</th><th>Nilai Normal</th><th>Status</th></tr>
            </thead>
            <tbody>
              @if(kritis.length)
                @each(k in kritis)
                  <tr class="table-danger">
                    <td>{{ k.no_permintaan }}</td>
                    <td>{{ k.nama_pasien }}</td>
                    <td>{{ k.nama_item }}</td>
                    <td><strong>{{ k.hasil_nilai }}</strong></td>
                    <td>{{ k.nilai_normal }}</td>
                    <td><span class="badge bg-secondary">{{ k.status }}</span></td>
                  </tr>
                @endeach
              @else
                <tr><td colspan="6" class="text-center text-muted py-4">Tidak ada hasil kritis saat ini.</td></tr>
              @endif
            </tbody>
          </table>
        </div>
      </div>
    </div>

    {{-- ============ Shortcut Menu ============ --}}
    <div class="col-md-5">
      <div class="card shadow-sm h-100">
        <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Akses Cepat</h6></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-6"><a href="/admin/laboratorium/permintaan" class="text-decoration-none"><div class="border rounded p-3 text-center hover-shadow"><i class="fas fa-clipboard-list fa-2x mb-2 text-primary"></i><div>Input Permintaan Baru</div></div></a></div>
            <div class="col-6"><a href="/admin/laboratorium/pemeriksaan" class="text-decoration-none"><div class="border rounded p-3 text-center"><i class="fas fa-microscope fa-2x mb-2 text-success"></i><div>Antrian &amp; Input Hasil</div></div></a></div>
            <div class="col-6"><a href="/admin/laboratorium/stok" class="text-decoration-none"><div class="border rounded p-3 text-center"><i class="fas fa-boxes-stacked fa-2x mb-2 text-warning"></i><div>Stok &amp; Reagen</div></div></a></div>
            <div class="col-6"><a href="/admin/laboratorium/laporan" class="text-decoration-none"><div class="border rounded p-3 text-center"><i class="fas fa-chart-line fa-2x mb-2 text-danger"></i><div>Laporan &amp; Analitik</div></div></a></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

