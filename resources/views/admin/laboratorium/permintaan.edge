@include("admin/laboratorium/_navbar")

<div class="container-fluid py-4">
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Permintaan &amp; Pendaftaran Pemeriksaan Lab</h5>
      <button class="btn btn-primary btn-sm" id="btnAddPermintaan"><i class="fas fa-plus me-1"></i>Input Permintaan Baru</button>
    </div>
    <div class="card-body">
      <table id="permintaanTable" class="table table-bordered table-hover w-100">
        <thead>
          <tr>
            <th width="4%">No</th><th>No. Permintaan</th><th>Pasien (RM)</th><th>Asal Ruangan</th>
            <th>Dokter Pengirim</th><th>Jenis Pemeriksaan</th><th>Status</th><th>Aksi</th>
          </tr>
        </thead>
      </table>
    </div>
  </div>
</div>

{{-- Modal Input Permintaan --}}
<div class="modal fade" id="modalPermintaan" tabindex="-1">
  <div class="modal-dialog">
    <form class="modal-content" id="formPermintaan">
      <div class="modal-header">
        <h5 class="modal-title">Input Permintaan Baru</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">No. Rekam Medis</label>
          <input type="text" class="form-control" name="no_rm" required></div>
        <div class="mb-3"><label class="form-label">Nama Pasien</label>
          <input type="text" class="form-control" name="nama_pasien" required></div>
        <div class="mb-3"><label class="form-label">Asal Ruangan / Poli</label>
          <input type="text" class="form-control" name="asal_ruangan" placeholder="mis. Poli Penyakit Dalam"></div>
        <div class="mb-3"><label class="form-label">Dokter Pengirim</label>
          <input type="text" class="form-control" name="dokter_pengirim"></div>
        <div class="mb-3"><label class="form-label">Jenis Pemeriksaan</label>
          <select class="form-select" name="kode_jenis" id="selJenis" required></select></div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Simpan &amp; Generate Barcode</button>
      </div>
    </form>
  </div>
</div>

{{-- Modal Barcode Label --}}
<div class="modal fade" id="modalBarcode" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content text-center">
      <div class="modal-header"><h5 class="modal-title">Label Barcode Tabung Sampel</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="barcodeText" style="font-family: 'Libre Barcode 39', monospace; font-size: 2rem;"></div>
        <canvas id="barcodeCanvas"></canvas>
        <div class="mt-2 fw-bold" id="barcodeNo"></div>
        <div class="small text-muted" id="barcodePasien"></div>
      </div>
      <div class="modal-footer justify-content-center">
        <button class="btn btn-primary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i>Cetak Label</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script src="/scripts/laboratorium_permintaan.js"></script>
</body>
</html>
