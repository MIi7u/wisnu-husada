<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Hasil Laboratorium {{ permintaan.no_permintaan }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 30px; }
    .kop { text-align: center; border-bottom: 3px double #000; padding-bottom: 10px; margin-bottom: 15px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { border: 1px solid #000; padding: 6px 8px; font-size: 13px; }
    th { background: #f2f2f2; }
    .info td { border: none; padding: 2px 6px; }
    .ttd { margin-top: 40px; width: 250px; float: right; text-align: center; }
    .kritis { color: #d00; font-weight: bold; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <div class="no-print" style="margin-bottom:15px">
    <button onclick="window.print()">🖨️ Cetak / Simpan PDF</button>
    <button onclick="history.back()">Kembali</button>
  </div>

  <div class="kop">
    <h3 style="margin:0">RS WISNU HUSADA</h3>
    <div>Instalasi Laboratorium</div>
  </div>

  <h4 style="text-align:center">HASIL PEMERIKSAAN LABORATORIUM</h4>

  <table class="info">
    <tr><td>No. Permintaan</td><td>: {{ permintaan.no_permintaan }}</td>
        <td>Tanggal</td><td>: {{ permintaan.tanggal_permintaan }}</td></tr>
    <tr><td>Nama Pasien</td><td>: {{ permintaan.nama_pasien }}</td>
        <td>No. RM</td><td>: {{ permintaan.no_rm }}</td></tr>
    <tr><td>Asal Ruangan</td><td>: {{ permintaan.asal_ruangan }}</td>
        <td>Dokter Pengirim</td><td>: {{ permintaan.dokter_pengirim }}</td></tr>
    <tr><td>Jenis Pemeriksaan</td><td colspan="3">: {{ permintaan.nama_pemeriksaan }}</td></tr>
  </table>

  <table>
    <thead><tr><th width="5%">No</th><th>Parameter</th><th>Hasil</th><th>Satuan</th><th>Nilai Normal</th></tr></thead>
    <tbody>
      @each(h in hasil)
        <tr>
          <td>{{ loop.index + 1 }}</td>
          <td>{{ h.nama_item }}</td>
          <td class="{{ h.kritis ? 'kritis' : '' }}">{{ h.hasil_nilai }} {{ h.kritis ? '⚠ KRITIS' : '' }}</td>
          <td>{{ h.satuan }}</td>
          <td>{{ h.nilai_normal }}</td>
        </tr>
      @else
        <tr><td colspan="5" class="text-center">Belum ada hasil terinput.</td></tr>
      @endeach
    </tbody>
  </table>

  <div class="ttd">
    <div>Mengetahui,</div>
    <div>Spesialis Patologi Klinik</div>
    <div style="height:60px"></div>
    <div>(.....................................)</div>
  </div>

  <script>setTimeout(() => window.print(), 500)</script>
</body>
</html>
