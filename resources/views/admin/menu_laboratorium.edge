<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>SIMRS-Wisnuhusada | Laboratorium</title>

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
  <div class="container-fluid">
    <a class="navbar-link active-menu" href="/">
      <i class="fas fa-house me-2"></i>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarNav" aria-controls="navbarNav"
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">

        <!-- 1. Dashboard -->
        <li class="nav-item">
          <a class="nav-link active-menu" href="/admin/laboratorium/dashboard"><i class="fas fa-gauge-high me-1"></i>Dashboard</a>
        </li>

        <!-- 2. Permintaan & Pendaftaran -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="reqMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-clipboard-list me-1"></i>Permintaan &amp; Pendaftaran
          </a>
          <ul class="dropdown-menu" aria-labelledby="reqMenu">
            <li><a class="dropdown-item" href="/admin/laboratorium/permintaan"><i class="fas fa-plus-circle me-2"></i>Input Permintaan Baru</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/permintaan"><i class="fas fa-barcode me-2"></i>Cetak Label Barcode</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/permintaan"><i class="fas fa-history me-2"></i>Riwayat Permintaan</a></li>
          </ul>
        </li>

        <!-- 3. Proses Pemeriksaan -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="prosesMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-microscope me-1"></i>Proses Pemeriksaan
          </a>
          <ul class="dropdown-menu" aria-labelledby="prosesMenu">
            <li><a class="dropdown-item" href="/admin/laboratorium/pemeriksaan"><i class="fas fa-list-ol me-2"></i>Antrian Sampel</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/pemeriksaan"><i class="fas fa-keyboard me-2"></i>Input Hasil Pemeriksaan</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/pemeriksaan"><i class="fas fa-user-doctor me-2"></i>Validasi Hasil (Sp.PK)</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/pemeriksaan"><i class="fas fa-file-pdf me-2"></i>Cetak Hasil Lab (PDF)</a></li>
          </ul>
        </li>

        <!-- 4. Manajemen Stok & Reagen -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="stokMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-boxes-stacked me-1"></i>Stok &amp; Reagen
          </a>
          <ul class="dropdown-menu" aria-labelledby="stokMenu">
            <li><a class="dropdown-item" href="/admin/laboratorium/stok"><i class="fas fa-vials me-2"></i>Master Data Reagen</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/stok"><i class="fas fa-exchange-alt me-2"></i>Transaksi Stok</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/stok"><i class="fas fa-brain me-2"></i>Prediksi Kebutuhan (ARIMA)</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium/stok"><i class="fas fa-calendar-xmark me-2"></i>Laporan Kedaluwarsa</a></li>
          </ul>
        </li>

        <!-- 5. Laporan & Analitik -->
        <li class="nav-item">
          <a class="nav-link" href="/admin/laboratorium/laporan"><i class="fas fa-chart-line me-1"></i>Laporan &amp; Analitik</a>
        </li>

        <!-- 6. Pengaturan -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="settingMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-gear me-1"></i>Pengaturan
          </a>
          <ul class="dropdown-menu" aria-labelledby="settingMenu">
            <li><a class="dropdown-item" href="/admin/laboratorium"><i class="fas fa-sitemap me-2"></i>Master Jenis Pemeriksaan</a></li>
            <li><a class="dropdown-item" href="/admin/laboratorium"><i class="fas fa-money-bill-wave me-2"></i>Tarif Lab per Ruang</a></li>
            <li><a class="dropdown-item" href="/admin/pegawai"><i class="fas fa-users-gear me-2"></i>Master Pengguna &amp; Hak Akses</a></li>
          </ul>
        </li>

      </ul>
    </div>
  </div>
</nav>

<div class="container-fluid py-4">
  <div class="row">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-white">
          <h5 class="mb-0">
            <i class="fas fa-flask me-2"></i>Layanan Laboratorium
          </h5>
        </div>
        <div class="card-body">
          <p class="text-muted">
            Halaman menu Laboratorium. Silakan pilih salah satu menu di atas.
          </p>
          <div class="row g-3">
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium/dashboard" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-gauge-high fa-2x mb-2 text-primary"></i><div>Dashboard</div></div></a></div>
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium/permintaan" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-clipboard-list fa-2x mb-2 text-success"></i><div>Permintaan &amp; Pendaftaran</div></div></a></div>
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium/pemeriksaan" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-microscope fa-2x mb-2 text-warning"></i><div>Proses Pemeriksaan</div></div></a></div>
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium/stok" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-boxes-stacked fa-2x mb-2 text-danger"></i><div>Stok &amp; Reagen (ARIMA)</div></div></a></div>
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium/laporan" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-chart-line fa-2x mb-2 text-info"></i><div>Laporan &amp; Analitik</div></div></a></div>
            <div class="col-md-4 col-lg-2"><a href="/admin/laboratorium" class="text-decoration-none"><div class="border rounded p-3 text-center h-100"><i class="fas fa-gear fa-2x mb-2 text-secondary"></i><div>Pengaturan</div></div></a></div>
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
