<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data DPJP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">

    <style>
        .card-header {
            background-color: #198754;
            color: white;
            font-weight: bold;
        }
        table.dataTable, table.dataTable th, table.dataTable td {
            border: 1px solid #dee2e6 !important;
        }
        table.dataTable {
            border-collapse: collapse !important;
        }
        table.dataTable thead th, table.dataTable tfoot th {
            background-color:rgb(4, 87, 49) !important;
            color: white !important;
            text-align: center;
        }
        table.dataTable tbody tr:hover {
            background-color: #f1f1f1;
        }
    </style>
</head>
<body>

<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between">
            <span>Filter Tanggal & Jenis Layanan</span>
            <button class="btn btn-light btn-sm" id="btnKembali">⬅ Kembali ke Menu</button>
        </div>
        <div class="card-body">
            <form id="filterForm" method="post" action="/admin/dpjb"> 
            {{ csrfField() }}
                <div class="row">
                    <div class="col-md-3">
                        <label>Tanggal Awal</label>
                        <input type="date" id="startDate" name="startDate" class="form-control" value="{{ startDate }}">
                    </div>
                    <div class="col-md-3">
                        <label>Tanggal Akhir</label>
                        <input type="date" id="endDate" name="endDate" class="form-control" value="{{ endDate }}">
                    </div>
                    <div class="col-md-3">
                        <label>Jenis Layanan</label>
                        <select id="jenisLayanan" class="form-control" name="jenisLayanan">
                            <option value="4">Semua</option>
                            <option value="1">Rawat Jalan</option>
                            <option value="2">Rawat Inap</option>
                            <option value="3">IGD</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-success w-100" type="submit">Filter</button>
                    </div>
                </div>
            </form>

            <!-- Alert Pesan Error -->
            <div id="alertTanggal" class="alert alert-danger mt-3 d-none" role="alert">
                Tanggal Awal tidak boleh lebih dari Tanggal Akhir!
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">Data DPJP</div>
        <div class="card-body">
            <table id="dpjbTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>Nama Dokter (DPJP)</th>
                        <th>Jumlah Pasien</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @each(data in dpjb)
                        <tr>
                            <td>{{ data.dpjp }}</td>
                            <td>{{ data.jumlah_pasien }}</td>
                            <td>
                               <a href="/admin/dpjb/detail/{{ data.dpjp }}?startDate={{ startDate }}&endDate={{ endDate }}&jenisLayanan={{ jenislayanan }}" class="btn btn-warning">Proses</a>

                            </td>
                        </tr>
                    @endeach
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
$(document).ready(function () {
    // Inisialisasi DataTables
    $('#dpjbTable').DataTable({
        paging: true,
        searching: true,
        columnDefs: [
            { orderable: false, targets: 0 },
            { width: "150px", targets: 2 }
        ]
    });

    // Tombol kembali
    $('#btnKembali').click(function () {
        window.location.href = '/';
    });

    // Validasi Tanggal Frontend
    $('#filterForm').submit(function (e) {
        let startDate = new Date($('#startDate').val());
        let endDate = new Date($('#endDate').val());

        if ($('#startDate').val() && $('#endDate').val() && startDate > endDate) {
            e.preventDefault(); // Stop submit
            $('#alertTanggal').removeClass('d-none'); // Tampilkan alert
        } else {
            $('#alertTanggal').addClass('d-none');
        }
    });
});
</script>

</body>
</html>
