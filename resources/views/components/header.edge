<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>{{title}}</title>
  <meta content={{title}}" name="description">
  <meta content="{{title}}" name="keywords">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

  <!-- Favicons -->
  <link href="/assets/logo-hitam.png" rel="icon">
  <link href="/assets/logo-hitam.png" rel="apple-touch-icon">

  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- bahanjees CSS Files -->
  <link href="/theme/niceadmin/bahanjees/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <!-- jangan lupa ini d update kalau d hosting -->
  <link href="/theme/niceadmin/bahanjees/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">


  <link href="/theme/niceadmin/bahanjees/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/theme/niceadmin/bahanjees/quill/quill.snow.css" rel="stylesheet">
  <link href="/theme/niceadmin/bahanjees/quill/quill.bubble.css" rel="stylesheet">
  <link href="/theme/niceadmin/bahanjees/remixicon/remixicon.css" rel="stylesheet">
  <link href="/theme/niceadmin/css/jquery.dataTables.min.css" rel="stylesheet">


  <!-- Template Main CSS File -->
  <link href="/theme/niceadmin/css/style.css" rel="stylesheet">
 <script src="/theme/sweatalert.js"></script>



  <!-- =======================================================
  * Template Name: NiceAdmin - v2.4.1
  * Template URL: https://bootstrapmade.com/nice-admin-bootstrap-admin-html-template/
  * Author: BootstrapMade.com
  * License: https://bootstrapmade.com/license/
  ======================================================== -->
</head>

<body class="">

  <!-- ======= Header ======= -->
  <header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
      <a href="/" class="logo d-flex align-items-center">
        
        <span class="d-none d-lg-block"><i class="bi bi-pin-map-fill"></i> {{title}}</span>
      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div>

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center">

     

        <li class="nav-item dropdown">

          <a class="nav-link nav-icon" href="#" data-bs-toggle="dropdown">
            <i class="bi bi-bell"></i>
            <span class="badge bg-warning badge-number text-dark">{{ revisi }}</span>
          </a><!-- End Notification Icon -->
         
        </li><!-- End Notification Nav -->

        <li class="nav-item dropdown pe-3">

          <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
             <i class="bi bi-person-circle"></i>
           
            <span class="d-none d-md-block dropdown-toggle ps-2">{{ user }} </span>
          </a><!-- End Profile Iamge Icon -->

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
          
           <li>
              <a class="dropdown-item d-flex align-items-center" href="/ubahpassword">
                <i class="bi bi-people"></i>
                <span>Ubah Password</span>
              </a>
            </li>           
            <li>
              <a class="dropdown-item d-flex align-items-center" href="/logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
              </a>
            </li>

          </ul><!-- End Profile Dropdown Items -->
        </li><!-- End Profile Nav -->

      </ul>
    </nav><!-- End Icons Navigation -->

  </header><!-- End Header -->
  <div class="modal fade" id="ubah_ta" tabindex="-1">
              <div class="modal-dialog modal-md">   
                      <div class="row">
                        <div class="col-md-12">            
                            <div class="card">      
                              <div class="modal-content">      
                                 <div class="card-body pb-3 table-responsive">
                                  <h5 class="card-title">Ubah Tahun Anggaran</span></h5>
                                  <form method="post" action="/ubahta">
                                  {{ csrfField() }}
                                  
                                  <div class="row">
                                  <div class="col-md-8">
                                    <input type="number" value="{{ta==null?'':ta.substring(0, 4)}}" name="ta" class="form-control" >
                                  </div>
                                 
                                  <div class="col-md-4">
                                    <input type="submit" class="btn btn-primary btn-sm" value="Simpan">
                                  </div>
                                  </div>
                                  </form>
                                  </div>
                              </div>
                            </div>
                        </div>
                      </div>      
              </div>
    </div>