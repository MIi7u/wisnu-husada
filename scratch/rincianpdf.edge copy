<!-- Card untuk Menampilkan Total -->
  <div class="card mt-4">
    <div class="card-header bg-success text-white">
      <h4>Total Perhitungan</h4>
    </div>
    <div class="card-body">
      <div id="totals" class="list-group">
        <div class="list-group-item d-flex justify-content-between">
          <span>Total Rawat Jalan</span>
          <span id="totalRawatJalan"></span>

        </div>
