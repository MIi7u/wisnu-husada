<script src="logo.js" defer></script>

<script>
$(document).ready(function() {
   
        $('#nipDokter').select2({
            placeholder: "Pilih Dokter", // Placeholder saat dropdown belum dipilih
            allowClear: true, // Tambahkan tombol "Hapus pilihan"
            width: "100%" // Pastikan dropdown menyesuaikan lebar
        });
   
    var table1 = $('#table1').DataTable({
        "pageLength": 5
    });

    var table2 = $('#table2').DataTable({
      "paging": true,  // Pagination aktif
    "searching": true, // Pencarian aktif
    "order": [[0, 'asc']], // Urutkan berdasarkan kolom pertama
    "columnDefs": [
        {
            "targets": 0, // Menentukan kolom pertama untuk nomor urut
            "orderable": false, // Menonaktifkan pengurutan pada kolom ini
            "render": function(data, type, row, meta) {
                return meta.row + 1 + meta.settings._iDisplayStart; // Menambahkan nomor urut
            }
        }
    ]
});

    function hitungTotalRawatJalan() {
        let total = 0;
        table1.rows({ search: 'applied' }).data().each(function(row) {
            let jumlahTagihan = row[4]; // Kolom ke-5
            if (typeof jumlahTagihan === "string") {
                jumlahTagihan = jumlahTagihan.trim();
            }
            let nilai = parseFloat(jumlahTagihan.replace(/[^0-9,-]/g, '').replace(',', '.')) || 0;
             // Jika angka memiliki dua nol desimal (390000.00) tapi terbaca 100x lebih besar, bagi 100
        if (nilai > 1000000) {  
            nilai = nilai / 100;  
        }
            total += nilai;
        });
        $('#totalRawatJalan').text(formatRupiah(total));
        return total;
    }

    function hitungTotalRawatInap() {
        let total = 0;
        table2.rows({ search: 'applied' }).data().each(function(row) {
            let jumlahTagihan = row[9]; // Kolom ke-10
            if (typeof jumlahTagihan === "string") {
                jumlahTagihan = jumlahTagihan.trim();
            }
            let nilai = parseFloat(jumlahTagihan.replace(/[^0-9,-]/g, '').replace(',', '.')) || 0;
             // Jika angka memiliki dua nol desimal (390000.00) tapi terbaca 100x lebih besar, bagi 100
        if (nilai > 1000000) {  
            nilai = nilai / 100;  
        }
            total += nilai;
        });
        $('#totalRawatInap').text(formatRupiah(total));
        return total;
    }

    function hitungTotalSewaAlat() {
        let total = 0;
        table2.rows({ search: 'applied' }).data().each(function(row) {
            let jumlahTagihan = row[8]; // Kolom ke-9
            if (typeof jumlahTagihan === "string") {
                jumlahTagihan = jumlahTagihan.trim();
            }
            let nilai = parseFloat(jumlahTagihan.replace(/[^0-9,-]/g, '').replace(',', '.')) || 0;
             // Jika angka memiliki dua nol desimal (390000.00) tapi terbaca 100x lebih besar, bagi 100
        if (nilai > 1000000) {  
            nilai = nilai / 100;  
        }
            total += nilai;
        });
        $('#totalSewaAlat').text(formatRupiah(total));
        return total;
    }

    function hitungTotalKeseluruhan() {
        let totalRawatJalan = hitungTotalRawatJalan();
        let totalRawatInap = hitungTotalRawatInap();
        let totalSewaAlat = hitungTotalSewaAlat();
        
        let totalKeseluruhan = totalRawatJalan + totalRawatInap + totalSewaAlat;
        $('#totalKeseluruhan').text(formatRupiah(totalKeseluruhan));

        // Simpan total ke variabel global agar bisa digunakan di hitungPPN
        Keseluruhan = totalKeseluruhan;

        hitungPPN(); // Panggil setelah total diperbarui
        hitungYangDiterima(); // Hitung Yang Diterima setelah PPN dihitung
        return totalKeseluruhan;
    }

    var Keseluruhan = 0; // Variabel global untuk menyimpan total

    function hitungPPN() {
        let ppn = Keseluruhan * 0.5 * 0.05;
        $('#ppn21').text(formatRupiah(ppn));
         // Simpan PPN ke variabel global agar bisa digunakan di hitungYangDiterima
        PPN = ppn;
        hitungYangDiterima()
    }
    
function hitungYangDiterima() {
    let yangDiterima = Keseluruhan - PPN;
    $('#yangDiterima').text(formatRupiah(yangDiterima));
}

    function formatRupiah(angka) {
        return 'Rp ' + angka.toLocaleString('id-ID', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    }

    // Pastikan DataTables selesai sebelum menghitung
    setTimeout(function() {
        hitungTotalKeseluruhan();
    }, 1500);

    // Hitung ulang saat tabel diperbarui, tapi tetap mempertahankan pagination
    $('#table1, #table2').on('draw.dt', function() {
        hitungTotalKeseluruhan();
       
    });
});

async function exportPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF('p', 'pt', 'a4');
    const pageWidth = doc.internal.pageSize.getWidth();
  
    const img = new Image();
    img.src = logoBase64; // ← ini penting!
    
    img.onload = async function () {
      doc.addImage(img, 'PNG', 40, 10, 50, 50);
      doc.setFontSize(14);
      doc.text('Rumah Sakit Islam Purwokerto', 100, 25);
      doc.setFontSize(8);
      doc.text('Jalan H. Masyhuri No. 39, Kotak Pos 144 Purwokerto', 100, 35);
      doc.text('Email: rsislam.purwokerto@gmail.com', 100, 45);
      doc.text('Phone: +62 858-7503-5300', 100, 55);
      doc.setFontSize(10);
      doc.text('RINCIAN JASA MEDIS PASIEN BPJS', 200, 75);
      doc.line(40, 100, pageWidth - 40, 100); // garis pemisah
  
     // Ambil semua instance DataTables
    const table1 = $('#table1').DataTable();
    const table2 = $('#table2').DataTable();

    // Simpan page length awal
    const len1 = table1.page.len();
    const len2 = table2.page.len();

    // Sembunyikan kontrol (pagination, search, info)
    $('.dataTables_length,.dataTables_filter, .dataTables_paginate,.dataTables_info').hide();

    // Tampilkan semua data
    table1.page.len(-1).draw();
    table2.page.len(-1).draw();
  
       // Tunggu render selesai
    await new Promise(resolve => setTimeout(resolve, 500));

    // Ambil elemen DOM tabel
    const el1 = document.querySelector('#table1_wrapper');
    const el2 = document.querySelector('#table2_wrapper');

    // Render tabel 1
    await html2canvas(el1).then(canvas => {
      const imgData = canvas.toDataURL('image/png');
      const imgProps = doc.getImageProperties(imgData);
      const pdfWidth = doc.internal.pageSize.getWidth();
      const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

      doc.addImage(imgData, 'PNG', 40, 110, pdfWidth - 80, pdfHeight);
    });

    // Render tabel 2 di halaman baru
    doc.addPage();
    await html2canvas(el2).then(canvas => {
      const imgData = canvas.toDataURL('image/png');
      const imgProps = doc.getImageProperties(imgData);
      const pdfWidth = doc.internal.pageSize.getWidth();
      const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

      doc.addImage(imgData, 'PNG', 40, 40, pdfWidth - 80, pdfHeight);
    });

    // Simpan PDF
    doc.save('DataLengkap.pdf');

    // Tampilkan kembali elemen semula & pagination
   $('.dataTables_length,.dataTables_filter, .dataTables_paginate,.dataTables_info').show();
    table1.page.len(len1).draw();
    table2.page.len(len2).draw();
  };

  img.onerror = function () {
    alert("Gagal memuat logo. Pastikan file logo.png tersedia dan dapat diakses.");
  };
}

 





</script>


</body>
