<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>RSI</title>
  
  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

  <style>
    /* Contoh background umum untuk body */
    body {
      background: url("/images/background.png") no-repeat center center fixed;
      background-size: cover;
    }

    /* Navbar dengan gradasi hijau */
    .navbar-custom {
      background: linear-gradient(to bottom, #8bc34a, #357905);
    }

    /* Karena warna navbar gelap, gunakan navbar-dark agar teks dan toggler putih */
    .navbar-custom .navbar-brand,
    .navbar-custom .nav-link,
    .navbar-custom .navbar-toggler-icon {
      color: #fff !important;
    }

    /* Dropdown hijau */
    .dropdown-menu {
      background-color: #218838;
    }
    .dropdown-item {
      color: #fff !important;
    }
    .dropdown-item:hover {
      background-color: #1e7e34;
    }
  </style>
</head>
<body>

  <!-- Pakai kelas kustom: navbar-dark + navbar-custom -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">RSI</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
              data-bs-target="#navbarNav" aria-controls="navbarNav" 
              aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Menu -->
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
           <!-- Dropdown Transaksi-->
           <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="masterMenu" 
               role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Transaksi
            </a>
            <ul class="dropdown-menu" aria-labelledby="masterMenu">
              <li><a class="dropdown-item" href="/admin/">Pembelian</a></li>
            </ul>
          </li>
          <!-- Dropdown Master -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="masterMenu" 
               role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Master
            </a>
            <ul class="dropdown-menu" aria-labelledby="masterMenu">
              <li><a class="dropdown-item" href="/admin/obat">Obat</a></li>
              <li><a class="dropdown-item" href="/admin/barang">Barang</a></li>
            </ul>
          </li>

          <!-- Dropdown Laporan -->
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="laporanMenu" 
               role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Laporan
            </a>
            <ul class="dropdown-menu" aria-labelledby="laporanMenu">
              <li><a class="dropdown-item" href="/admin/pending">Pending BPJS</a></li>
              <li><a class="dropdown-item" href="/admin/rincian">Rincian Jasa Medis BPJS</a></li>
              <li><a class="dropdown-item" href="/admin/nonbpjs">Rincian Jasa Medis NON BPJS</a></li>
            </ul>
          </li>
        </ul>

        <!-- Logo di sisi kanan -->
        <img src="/images/logo_rsi.png" alt="Logo" height="40">
      </div>
    </div>
  </nav>

  <!-- Bootstrap JS (Popper sudah include di bundle) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
