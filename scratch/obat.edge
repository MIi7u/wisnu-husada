<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Data Obat</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
</head>
<body>
<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Data Obat</h5>
    </div>
    <div class="card-body">
      <button class="btn btn-success mb-3" id="btnTambah">+ Tambah Obat</button>
      <div class="table-responsive">
        <table id="obatTable" class="table table-bordered table-hover">
          <thead class="table-light">
            <tr>
              <th></th>
              <th>Kode</th>
              <th>Nama</th>
              <th>Satuan</th>
              <th>Harga</th>
              <th>Aksi</th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalObat" tabindex="-1">
  <div class="modal-dialog">
    <form id="formObat">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Form Obat</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="id" name="id">
          <div class="mb-3">
            <label>Kode Obat</label>
            <input type="text" class="form-control" name="kode" required>
          </div>
          <div class="mb-3">
            <label>Nama Obat</label>
            <input type="text" class="form-control" name="nama" required>
          </div>
          <div class="mb-3">
            <label>Satuan</label>
            <input type="text" class="form-control" name="satuan" required>
          </div>
          <div class="mb-3">
            <label>Harga</label>
            <input type="number" class="form-control" name="harga" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-success">Simpan</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
let modal = new bootstrap.Modal(document.getElementById('modalObat'))
let table = $('#obatTable').DataTable({
  ajax: '/admin/obat/data',
  columns: [
    {
      className: 'dt-control',
      orderable: false,
      data: null,
      defaultContent: ''
    },
    { data: 'kode' },
    { data: 'nama' },
    { data: 'satuan' },
    { data: 'harga' },
    {
      data: null,
      render: function(data) {
        return `
          <button class="btn btn-sm btn-warning btn-edit" data-id="${data.id}">Edit</button>
          <button class="btn btn-sm btn-danger btn-hapus" data-id="${data.id}">Hapus</button>
        `
      }
    }
  ]
});

$('#obatTable tbody').on('click', 'td.dt-control', function () {
  let tr = $(this).closest('tr');
  let row = table.row(tr);
  if (row.child.isShown()) {
    row.child.hide();
    tr.removeClass('shown');
  } else {
    let data = row.data();
    row.child(`
      <table class="table table-sm">
        <tr><td><b>Kode:</b> ${data.kode}</td></tr>
        <tr><td><b>Nama:</b> ${data.nama}</td></tr>
        <tr><td><b>Satuan:</b> ${data.satuan}</td></tr>
        <tr><td><b>Harga:</b> Rp ${data.harga}</td></tr>
      </table>
    `).show();
    tr.addClass('shown');
  }
});

$('#btnTambah').click(() => {
  $('#formObat')[0].reset();
  $('#id').val('');
  modal.show();
});

$('#formObat').on('submit', function(e) {
  e.preventDefault();
  let data = $(this).serialize();
  $.post('/admin/obat/simpan', data, function() {
    modal.hide();
    table.ajax.reload();
  });
});

$('#obatTable').on('click', '.btn-edit', function() {
  let id = $(this).data('id');
  $.get(`/admin/obat/${id}`, function(data) {
    for (let key in data) {
      $(`[name="${key}"]`).val(data[key]);
    }
    $('#id').val(data.id);
    modal.show();
  });
});

$('#obatTable').on('click', '.btn-hapus', function() {
  if (confirm('Yakin ingin menghapus?')) {
    let id = $(this).data('id');
    $.ajax({
      url: `/admin/obat/${id}`,
      type: 'DELETE',
      success: () => table.ajax.reload()
    });
  }
});
</script>
</body>
</html>
